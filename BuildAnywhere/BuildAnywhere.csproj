<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>1.1.0</Version>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RepositoryUrl>https://github.com/Truinto/GYK-BuildAnywhere</RepositoryUrl>
		<RootNamespace>$(MSBuildProjectName)</RootNamespace>
	</PropertyGroup>

	<!-- Common References -->
	<ItemGroup>
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Xml" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Data" />
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<!-- Project References -->
	<ItemGroup>
		<PackageReference PrivateAssets="all" Include="Lib.Harmony" Version="2.0.4" />
		<Reference Include="Assembly-CSharp" HintPath="$(GameManaged)/Assembly-CSharp.dll" Publicize="true" />
		<Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManaged)/Assembly-CSharp-firstpass.dll" Publicize="true" />

		<Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)/Newtonsoft.Json.dll" />
		<Reference Include="QModHelper" HintPath="$(GameManaged)/Helper.dll" />
		<Reference Include="UnityModManager" HintPath="$(GameManaged)/UnityModManager/UnityModManager.dll" />

		<Reference Include="UnityEngine" HintPath="$(GameManaged)/UnityEngine.dll" />
		<Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)/UnityEngine.CoreModule.dll" />
		<Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManaged)/UnityEngine.InputLegacyModule.dll" />
		<Reference Include="UnityEngine.UI" HintPath="$(GameManaged)/UnityEngine.UI.dll" />
		<Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManaged)/UnityEngine.IMGUIModule.dll" />
	</ItemGroup>

	<!-- Other Files -->
	<ItemGroup>
		<None Update="changelog.md" CopyToOutputDirectory="PreserveNewest" />
		<None Update="mod.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

    <ItemGroup>
        <VersioningTask_In Include="$(MSBuildThisFileFullPath)" />
        <VersioningTask_In Include="changelog.md" />
        <VersioningTask_Out DropRevision="never" Include="$(MSBuildThisFileFullPath)" />
        <VersioningTask_Out DropRevision="keep" Include="mod.json" />
        <VersioningTask_Out DropRevision="keep" Include="Settings/Repository.json" Max="2" />

        <TargetCopyTarget Include="$(ModFolder)/$(TargetName)/" />
        <TargetCopyDelete Include="$(ModFolder)/$(TargetName)/$(TargetName).pdb" Condition="$(Configuration.Contains('Release'))" />
        <TargetCopyDelete Include="$(ModFolder)/$(TargetName)/$(TargetName).xml" Condition="$(Configuration.Contains('Release'))" />

        <TargetZipWorkDir Include="$(ModFolder)" />
        <TargetZipTarget Include="$(SolutionDir)/publish/$(TargetName).zip" />
    </ItemGroup>

</Project>
