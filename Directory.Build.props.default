<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ProgramFolder>C:/Program Files (x86)/Steam/steamapps/common/</ProgramFolder>
    <GameManaged>$(ProgramFolder)Graveyard Keeper/Graveyard Keeper_Data/Managed</GameManaged>
    <GameManaged Condition="!Exists('$(GameManaged)')">$(SolutionDir)../1st_sources/GYK sources</GameManaged>
    <ModFolder>$(ProgramFolder)Graveyard Keeper/QMods</ModFolder>
    <ModFolder Condition="!Exists('$(ModFolder)')">$(SolutionDir)../1st_sources/GYK sources</ModFolder>
  </PropertyGroup>
</Project>
